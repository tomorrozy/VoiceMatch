/* app.wxss — 全局样式（深色音乐氛围） */
page {
  --bg: #0f1029;
  --bg-card: #1a1b3a;
  --bg-card-2: #232451;
  --primary: #7c6cff;
  --primary-soft: #a99dff;
  --accent: #4de0d0;
  --accent-2: #ff7eb6;
  --text: #ffffff;
  --text-sub: #b9b9d6;
  --text-dim: #7d7fa8;
  --border: rgba(255, 255, 255, 0.1);
  --radius: 24rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  background: var(--bg);
  color: var(--text);
  box-sizing: border-box;
}

view, text, button, input {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 20% 0%, rgba(124, 108, 255, 0.18), transparent 45%),
    radial-gradient(circle at 90% 20%, rgba(77, 224, 208, 0.12), transparent 40%),
    var(--bg);
  padding: 0 32rpx 60rpx;
}

.card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 32rpx;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), #5a7bff);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}

.btn-primary::after { border: none; }

.btn-primary[disabled] {
  opacity: 0.45;
}

.btn-ghost {
  background: transparent;
  color: var(--text-sub);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-ghost::after { border: none; }

.title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--accent);
  background: rgba(77, 224, 208, 0.12);
  border: 1rpx solid rgba(77, 224, 208, 0.3);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
