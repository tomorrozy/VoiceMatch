<view class="page result-page">
  <!-- 服务异常（status=error）：与录音质量拒答分开处理 -->
  <block wx:if="{{errorInfo}}">
    <view class="reject-state">
      <view class="reject-icon">🔌</view>
      <view class="title">这次分析没有完成</view>
      <view class="reject-reason">{{errorInfo.message}}</view>
      <view wx:if="{{errorInfo.detail}}" class="quality-box card">
        <view class="q-title">技术详情</view>
        <view class="q-detail">{{errorInfo.detail}}</view>
      </view>
      <button class="btn-primary report-btn" bindtap="onRetry">返回重新提交</button>
      <button class="btn-ghost again-btn" bindtap="onBackHome">回到首页</button>
    </view>
  </block>

  <block wx:elif="{{result.status === 'ok'}}">
    <view class="result-head">
      <view class="tag">✨ 分析完成</view>
      <view class="title">你最像</view>
      <view class="top1-name">{{result.results[0].name}}</view>
      <view class="top1-style">{{result.results[0].style}}</view>
    </view>

    <!-- R29：库的配对状态不满足时，分数只能当排序用；文案由服务端给 -->
    <view wx:if="{{pairingNotice}}" class="pairing-warn">
      ⚠️ {{pairingNotice}}
    </view>

    <!-- 冠军卡片 -->
    <view class="champion card">
      <view class="crown">👑</view>
      <view class="champ-score">
        <text class="cs-num">{{result.results[0].scoreText}}</text>
        <text class="cs-label">{{scoreAsPercent ? '感知相似度' : '排序序号'}}</text>
      </view>
      <view class="champ-attr">{{result.results[0].attributionText}}</view>
      <view wx:if="{{!result.calibrated}}" class="calib-warn">
        校准模型尚未就绪，当前分数仅用于排序，不代表百分比相似度。
      </view>
    </view>

    <!-- Top-3 列表 -->
    <view class="rank-title">最接近的 3 位歌手</view>
    <view class="rank-list">
      <view class="rank-item card" wx:for="{{result.results}}" wx:key="singer_id">
        <view class="rank-no">{{index + 1}}</view>
        <view class="rank-info">
          <view class="rank-name">{{item.name}}</view>
          <view class="rank-style">{{item.style}}</view>
          <view class="rank-bar"><view class="rank-bar-fill" style="width:{{item.score * 100}}%"></view></view>
        </view>
        <view class="rank-score">{{item.scoreText}}</view>
      </view>
    </view>

    <button class="btn-primary report-btn" bindtap="onReport">查看完整解析报告 →</button>
    <button class="btn-ghost poster-btn" bindtap="onSavePoster" disabled="{{posterSaving}}">
      {{posterSaving ? '正在生成…' : '生成分享海报'}}
    </button>
    <button class="btn-ghost again-btn" bindtap="onAgain">重新测一次</button>
  </block>

  <!-- 拒答 / 无可用窗口分支（对齐 CLI rejected / no_usable_window） -->
  <block wx:else>
    <view class="reject-state">
      <view class="reject-icon">{{result.status === 'no_usable_window' ? '🔇' : '🎚️'}}</view>
      <view class="title">{{result.status === 'no_usable_window' ? '没找到合适的片段' : '这段声音还不好判断'}}</view>
      <view class="reject-reason">{{rejectReason}}</view>
      <view class="quality-box card">
        <view class="q-title">录音质量参考</view>
        <view class="q-row"><text>有效发声</text><text>{{result.quality.speech_sec}} 秒</text></view>
        <view class="q-row"><text>信噪比</text><text>{{result.quality.snr_db}} dB</text></view>
        <view class="q-row"><text>有声比例</text><text>{{result.quality.voiced_ratio}}</text></view>
      </view>
      <button class="btn-primary report-btn" bindtap="onAgain">重新录一段</button>
    </view>
  </block>

  <view class="version-foot" wx:if="{{result.status === 'ok'}}">
    模型 {{result.model_id}} · 库 {{result.library_version}} · 校准 {{result.calibration_version}}
  </view>

  <!-- 分享海报画布：固定在屏幕外，仅用于导出图片 -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
</view>
