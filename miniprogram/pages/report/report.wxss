.report-page { padding-top: 40rpx; }

.report-hero { text-align: center; padding: 20rpx 0 40rpx; }
.rh-main { font-size: 30rpx; color: var(--text-sub); margin: 24rpx 0 8rpx; }
.rh-name { color: var(--text); font-weight: 700; font-size: 36rpx; }
.rh-score {
  font-size: 100rpx; font-weight: 800; color: var(--accent); line-height: 1.2;
}
.rh-attr {
  display: inline-block; font-size: 26rpx; color: var(--primary-soft);
  background: rgba(124,108,255,0.12); border-radius: 999rpx; padding: 10rpx 30rpx; margin-top: 8rpx;
}

.section { margin-bottom: 28rpx; }
.sec-head { margin-bottom: 32rpx; }
.sec-title { font-size: 32rpx; font-weight: 700; }
.sec-sub { font-size: 22rpx; color: var(--text-dim); margin-top: 10rpx; line-height: 1.6; }

.dim-item { margin-bottom: 36rpx; }
.dim-item:last-child { margin-bottom: 8rpx; }
.dim-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; }
.dim-label { font-size: 28rpx; font-weight: 600; }
.dim-value { font-size: 30rpx; font-weight: 700; color: var(--accent); }
.dim-track {
  position: relative; height: 14rpx; border-radius: 14rpx;
  background: rgba(255,255,255,0.08); overflow: hidden;
}
.dim-fill { height: 100%; border-radius: 14rpx; transition: width 0.6s ease; }
.dim-mark { position: absolute; top: 0; width: 2rpx; height: 100%; background: rgba(255,255,255,0.35); }
.dim-desc { font-size: 22rpx; color: var(--text-dim); margin-top: 10rpx; }

.attr-item { display: flex; align-items: center; margin-bottom: 24rpx; }
.attr-item:last-child { margin-bottom: 8rpx; }
.attr-dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; }
.attr-name { font-size: 26rpx; width: 90rpx; color: var(--text-sub); }
.attr-track { flex: 1; height: 10rpx; background: rgba(255,255,255,0.08); border-radius: 10rpx; overflow: hidden; margin: 0 16rpx; }
.attr-fill { height: 100%; border-radius: 10rpx; }
.attr-pct { font-size: 24rpx; width: 70rpx; text-align: right; color: var(--text-sub); }

.notice {
  font-size: 24rpx; color: var(--text-sub); line-height: 1.7;
  background: rgba(124,108,255,0.1); border: 1rpx solid rgba(124,108,255,0.25);
  border-radius: 16rpx; padding: 20rpx 24rpx; margin-bottom: 28rpx;
}
.notice-warn { color: #ffcf8a; background: rgba(255,180,80,0.1); border-color: rgba(255,180,80,0.3); }

.version-card {
  background: rgba(255,255,255,0.03); border: 1rpx solid var(--border);
  border-radius: 16rpx; padding: 24rpx; margin-bottom: 32rpx;
}
.v-row { display: flex; justify-content: space-between; font-size: 20rpx; color: var(--text-dim); padding: 8rpx 0; }
.v-row text:last-child { color: var(--text-sub); max-width: 70%; word-break: break-all; text-align: right; }
.v-note { font-size: 20rpx; color: var(--text-dim); margin-top: 16rpx; text-align: center; }

.save-btn { width: 100%; }
