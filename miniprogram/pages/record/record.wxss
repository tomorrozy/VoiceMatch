.record-page { padding-top: 50rpx; display: flex; flex-direction: column; }
.record-header .title { margin-bottom: 16rpx; }
.record-header .subtitle { white-space: pre-line; }

.disc-wrap {
  position: relative; display: flex; flex-direction: column;
  align-items: center; justify-content: center; margin: 60rpx 0 40rpx;
}
.disc-ring {
  position: absolute; width: 380rpx; height: 380rpx; border-radius: 50%;
  border: 2rpx solid rgba(124,108,255,0.25);
}
.disc-ring.ring-active { animation: ripple 1.5s ease-out infinite; }
@keyframes ripple {
  0% { transform: scale(0.9); opacity: 0.8; }
  100% { transform: scale(1.15); opacity: 0; }
}
.disc {
  width: 260rpx; height: 260rpx; border-radius: 50%;
  background: linear-gradient(145deg, #2a2b5e, #161735);
  border: 1rpx solid rgba(255,255,255,0.12);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.4), inset 0 0 60rpx rgba(124,108,255,0.15);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.3s;
}
.disc-active {
  background: linear-gradient(145deg, #6a5cff, #4a3fd6);
  box-shadow: 0 0 80rpx rgba(124,108,255,0.6), inset 0 0 40rpx rgba(255,255,255,0.2);
}
.disc-icon { font-size: 88rpx; }
.timer {
  font-size: 56rpx; font-weight: 700; margin-top: 36rpx;
  font-variant-numeric: tabular-nums; letter-spacing: 2rpx;
}
.hint { font-size: 26rpx; color: var(--text-dim); margin-top: 8rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: center; margin-bottom: 40rpx; }
.chip {
  font-size: 23rpx; color: var(--text-sub);
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--border);
  padding: 12rpx 22rpx; border-radius: 999rpx;
}

.actions { margin-top: auto; }
.record-btn { width: 100%; }
.recorded-actions {
  background: var(--bg-card); border: 1rpx solid var(--border);
  border-radius: var(--radius); padding: 32rpx;
}
.recorded-info { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; }
.ri-label { font-size: 28rpx; color: var(--text-sub); }
.ri-time { font-size: 40rpx; font-weight: 700; color: var(--accent); }
.btn-row { display: flex; gap: 20rpx; }
.btn-row > button { flex: 1; }

.record-foot {
  font-size: 22rpx; color: var(--text-dim); text-align: center;
  line-height: 1.7; margin-top: 32rpx; padding: 0 24rpx;
}

/* 分析服务连接状态 */
.service-chip {
  align-self: center; display: flex; align-items: center;
  margin-top: 24rpx; padding: 10rpx 24rpx; border-radius: 999rpx;
  font-size: 22rpx; color: var(--text-sub);
  background: rgba(255,255,255,0.05); border: 1rpx solid var(--border);
}
.service-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--text-dim); margin-right: 12rpx; flex-shrink: 0;
}
.service-chip.ok .service-dot { background: var(--accent); box-shadow: 0 0 12rpx var(--accent); }
.service-chip.down .service-dot { background: #ff7e7e; }
.service-chip.checking .service-dot { background: #ffcf8a; animation: dot-pulse 1s ease-in-out infinite; }
@keyframes dot-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
.service-detail {
  text-align: center; font-size: 20rpx; color: var(--text-dim);
  margin-top: 10rpx; padding: 0 24rpx;
}

/* 上传进度 */
.upload-meta {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12rpx;
}
.um-text {
  font-size: 24rpx; color: rgba(255,255,255,0.62);
  flex: 1; margin-right: 16rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.um-pct {
  font-size: 24rpx; color: var(--accent);
  font-variant-numeric: tabular-nums;
}
.upload-track {
  height: 8rpx; background: rgba(255,255,255,0.08);
  border-radius: 8rpx; overflow: hidden; margin-bottom: 24rpx;
}
.upload-fill {
  height: 100%; border-radius: 8rpx;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  transition: width 0.2s ease;
}

/* 试听 */
.play-row { display: flex; align-items: center; margin-bottom: 28rpx; }
.play-btn {
  width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(124,108,255,0.16); border: 1rpx solid rgba(124,108,255,0.35);
  color: var(--primary-soft); font-size: 30rpx; margin-right: 20rpx;
}
.play-btn.playing { background: rgba(77,224,208,0.16); border-color: rgba(77,224,208,0.4); color: var(--accent); }
.play-title { font-size: 27rpx; color: var(--text); }
.play-sub { font-size: 21rpx; color: var(--text-dim); margin-top: 4rpx; }

/* 取消分析 */
.btn-cancel {
  width: 100%; margin-top: 18rpx;
  background: transparent; border: 1rpx solid rgba(238,10,36,0.35);
  color: #ff7a8a; font-size: 26rpx; border-radius: 16rpx;
  line-height: 72rpx; height: 72rpx;
}
.btn-cancel[disabled] { opacity: 0.5; }
