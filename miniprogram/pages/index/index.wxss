.index-page { padding-top: 60rpx; }

.hero { position: relative; text-align: center; padding: 20rpx 0 40rpx; }
.hero-glow {
  position: absolute; left: 50%; top: -60rpx; transform: translateX(-50%);
  width: 500rpx; height: 500rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(124,108,255,0.35), transparent 65%);
  z-index: 0; pointer-events: none;
}
.badge {
  position: relative; z-index: 1;
  display: inline-block; font-size: 24rpx; color: var(--accent);
  background: rgba(77,224,208,0.1); border: 1rpx solid rgba(77,224,208,0.3);
  padding: 10rpx 26rpx; border-radius: 999rpx; margin-bottom: 36rpx;
}
.hero-title {
  position: relative; z-index: 1;
  font-size: 76rpx; font-weight: 800; line-height: 1.2; white-space: pre-line;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #fff 20%, var(--primary-soft) 90%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.hero-sub {
  position: relative; z-index: 1;
  font-size: 28rpx; color: var(--text-sub); line-height: 1.7;
  margin: 28rpx auto 0; white-space: pre-line;
}

.wave {
  display: flex; align-items: center; justify-content: center;
  gap: 10rpx; height: 120rpx; margin-top: 30rpx;
}
.bar {
  width: 10rpx; border-radius: 8rpx;
  background: linear-gradient(180deg, var(--accent), var(--primary));
  animation: pulse 1.1s ease-in-out infinite alternate;
}
@keyframes pulse {
  from { transform: scaleY(0.5); }
  to { transform: scaleY(1); }
}

.section { margin-top: 20rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 28rpx; }
.gender-row { display: flex; gap: 24rpx; }
.gender-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 28rpx 0; border-radius: 20rpx;
  background: var(--bg-card-2); border: 2rpx solid transparent;
  transition: all 0.2s;
}
.gender-item.active {
  border-color: var(--primary);
  background: rgba(124,108,255,0.16);
}
.gender-emoji { font-size: 56rpx; }
.gender-label { font-size: 28rpx; margin-top: 12rpx; color: var(--text-sub); }
.gender-item.active .gender-label { color: var(--text); font-weight: 600; }

.steps { margin: 40rpx 0; }
.step { display: flex; align-items: center; margin-bottom: 24rpx; }
.step-num {
  width: 48rpx; height: 48rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(124,108,255,0.2); color: var(--primary-soft);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700; margin-right: 20rpx;
}
.step-text { font-size: 28rpx; color: var(--text-sub); }

.start-btn { width: 100%; margin-top: 10rpx; }

.privacy-tip {
  font-size: 22rpx; color: var(--text-dim); text-align: center;
  line-height: 1.7; margin-top: 28rpx; padding: 0 20rpx;
}
.link { color: var(--primary-soft); display: inline; }

/* 隐私弹窗 */
.mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.7);
  display: flex; align-items: center; justify-content: center;
  padding: 48rpx; z-index: 999;
}
.privacy-modal {
  width: 100%; background: var(--bg-card); border: 1rpx solid var(--border);
  border-radius: 28rpx; padding: 44rpx 36rpx 36rpx;
}
.pm-title { font-size: 36rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.pm-desc { font-size: 27rpx; color: var(--text-sub); line-height: 1.8; }
.pm-links { margin-top: 24rpx; }
.pm-link { font-size: 25rpx; color: var(--primary-soft); line-height: 2; }
.pm-btns { display: flex; gap: 20rpx; margin-top: 40rpx; }
.pm-btns > button { flex: 1; }

/* 快捷入口 */
.quick-links { display: flex; gap: 16rpx; margin-top: 20rpx; }
.quick-link {
  flex: 1; display: flex; align-items: center;
  padding: 22rpx 24rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.04); border: 1rpx solid var(--border);
  font-size: 25rpx; color: var(--text-sub);
}
button.quick-link { margin: 0; line-height: normal; text-align: left; }
button.quick-link::after { border: none; }
.ql-icon { margin-right: 10rpx; }
.ql-text { flex: 1; }
.ql-arrow { color: var(--text-dim); }
