.history-page { padding-top: 50rpx; }
.h-head { margin-bottom: 36rpx; }
.h-title { font-size: 48rpx; font-weight: 700; }
.h-sub { font-size: 24rpx; color: var(--text-dim); margin-top: 10rpx; }

.h-list { display: flex; flex-direction: column; gap: 16rpx; }
.h-item { display: flex; align-items: center; padding: 26rpx 24rpx; }
.h-rank {
  width: 52rpx; height: 52rpx; border-radius: 16rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  background: rgba(124,108,255,0.16); color: var(--primary-soft);
  font-size: 26rpx; font-weight: 700; margin-right: 20rpx;
}
.h-info { flex: 1; min-width: 0; }
.h-name {
  font-size: 31rpx; font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.h-meta {
  font-size: 21rpx; color: var(--text-dim); margin-top: 6rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.h-score { font-size: 32rpx; font-weight: 700; color: var(--accent); margin: 0 18rpx; }
.h-del {
  width: 48rpx; height: 48rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-dim); font-size: 24rpx;
  background: rgba(255,255,255,0.05);
}
.clear-all { width: 100%; margin-top: 28rpx; }

.empty { text-align: center; padding-top: 120rpx; }
.empty-icon { font-size: 110rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; }
.empty-sub {
  font-size: 25rpx; color: var(--text-dim); line-height: 1.7;
  margin: 16rpx auto 44rpx; padding: 0 40rpx;
}
.empty-btn { width: 360rpx; }

.h-foot {
  font-size: 21rpx; color: var(--text-dim); text-align: center;
  margin-top: 36rpx; line-height: 1.7;
}

.h-rank-muted { color: var(--text-dim); background: rgba(255,255,255,0.05); }
