<view class="page history-page">
  <view class="h-head">
    <view class="h-title">历史记录</view>
    <view class="h-sub">{{summary}}</view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <view class="empty-icon">🎧</view>
    <view class="empty-title">还没有留下声音档案</view>
    <view class="empty-sub">测一次，就能在这里回看最像谁与四维解析报告。</view>
    <button class="btn-primary empty-btn" bindtap="onGoRecord">去测一次</button>
  </view>

  <view wx:else class="h-list">
    <view class="h-item card" wx:for="{{list}}" wx:key="id" data-index="{{index}}" bindtap="onOpen">
      <view class="h-rank {{item.status === 'ok' ? '' : 'h-rank-muted'}}">{{item.status === 'ok' ? (index + 1) : '·'}}</view>
      <view class="h-info">
        <view class="h-name">{{item.name || '未出结果'}}</view>
        <view class="h-meta">{{item.statusText}} · {{item.seconds}}s · {{item.timeText}}</view>
      </view>
      <view class="h-score" wx:if="{{item.status === 'ok'}}">{{item.scoreText}}</view>
      <view class="h-del" data-index="{{index}}" catchtap="onDelete">✕</view>
    </view>
    <button class="btn-ghost clear-all" bindtap="onClear">清空历史记录</button>
  </view>

  <view class="h-foot">结果仅保存在本机，不会上传；删除后不可恢复。</view>
</view>
